{
  "name": "@adequate/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ADEQUATE operational Expo member app; standalone install preserves the design preview",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@supabase/supabase-js": "2.117.3",
    "expo": "57.0.27",
    "expo-audio": "57.0.5",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.12",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
