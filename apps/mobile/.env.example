# Public values only. Never add a service-role key here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# API allows native auth redirect; configure same exact URL in Supabase Auth.
EXPO_PUBLIC_AUTH_REDIRECT_URL=adequate://auth/callback
# Set true ONLY for insecure local emulator/LAN debugging. Never for release builds.
EXPO_PUBLIC_ALLOW_INSECURE_LOCAL_DEV=false
