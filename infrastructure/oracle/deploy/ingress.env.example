# Root-owned /etc/adequate-inference/ingress.env, mode 0600.
# Values must be supplied from the approved network and TLS plan, not copied as-is.
INFERENCE_HOST=REPLACE_WITH_APPROVED_TLS_HOSTNAME
INFERENCE_BIND=REPLACE_WITH_APPROVED_VPN_OR_PRIVATE_ADDRESS
INFERENCE_ALLOWED_CIDRS=REPLACE_WITH_APPROVED_CALLER_CIDRS
INFERENCE_TLS_CERT=/etc/adequate-inference/tls/fullchain.pem
INFERENCE_TLS_KEY=/etc/adequate-inference/tls/private.key
