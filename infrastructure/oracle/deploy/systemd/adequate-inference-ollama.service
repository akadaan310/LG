[Unit]
Description=ADEQUATE CPU-only resident Ollama runtime
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=adequate-inference
Group=adequate-inference
EnvironmentFile=/etc/adequate-inference/runtime.env
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/adequate-inference/ollama
Environment=OLLAMA_KEEP_ALIVE=-1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_QUEUE=1
Environment=OLLAMA_DEBUG=false
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=ROCR_VISIBLE_DEVICES=-1
ExecStart=/usr/local/bin/ollama serve
ExecStartPost=/opt/adequate-inference/infrastructure/oracle/deploy/scripts/warm.sh ollama
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=35
StateDirectory=adequate-inference
# Raw runtime output is suppressed because upstream runtimes may emit prompt text.
StandardOutput=null
StandardError=null
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/adequate-inference
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
