# Root-owned /etc/adequate-inference/runtime.env, mode 0600.
# Plain KEY=value only: no shell expressions, quotes, or inline comments.
# mock is the safe development default. Real model/runtime selection needs approval.
RUNTIME=mock
RUNTIME_URL=http://127.0.0.1:11434
MODEL=REPLACE_WITH_APPROVED_INSTALLED_MODEL
MODEL_PATH=/var/lib/adequate-inference/models/REPLACE_WITH_VERIFIED_GGUF
RUNTIME_THREADS=REPLACE_AFTER_HOST_INSPECTION
CONTEXT_SIZE=2048
WARM_TIMEOUT_SECONDS=180
