# Root-owned /etc/adequate-inference/gateway.env, mode 0600; never commit real values.
# Generate a unique service token through the approved secret manager (>=32 characters).
HOST=127.0.0.1
PORT=8787
GATEWAY_TOKEN=REPLACE_WITH_SECURE_RANDOM_SERVICE_TOKEN
MAX_CONCURRENT=1
MAX_QUEUED=8
DEADLINE_MS=15000
REGISTRY_FILE=/opt/adequate-inference/infrastructure/oracle/registry.json
