{
  "name": "adequate-design-atelier",
  "private": true,
  "version": "0.1.0",
  "description": "ADEQUATE Design Atelier — design-only review prototype (no backend, no production logic).",
  "workspaces": [
    "packages/*",
    "apps/atelier"
  ],
  "scripts": {
    "dev": "npm run dev -w @adequate/atelier",
    "build": "npm run build -w @adequate/atelier",
    "start": "npm run start -w @adequate/atelier",
    "typecheck": "npm run typecheck -w @adequate/design-tokens -w @adequate/mock-content -w @adequate/atelier",
    "lint": "npm run lint -w @adequate/atelier",
    "check": "npm run typecheck && npm run lint && npm run build",
    "smoke": "node apps/atelier/scripts/smoke.mjs",
    "native:install": "npm install --prefix apps/native-preview --no-workspaces",
    "native:start": "npm run start --prefix apps/native-preview",
    "native:typecheck": "npm run typecheck --prefix apps/native-preview",
    "native:export": "npm run export:atelier --prefix apps/native-preview"
  },
  "engines": {
    "node": ">=20"
  }
}
