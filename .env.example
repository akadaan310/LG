# Copy to apps/platform/.env.local. No production project is linked by default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3100
AGE_POLICY_APPROVED=false
# Server only: privileged key used solely for hashed anonymous auth rate counters.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_RATE_LIMIT_SALT=
AI_MODE=disabled
PATHWAYS_REVIEW_APPROVED=false
ORACLE_GATEWAY_URL=
ORACLE_GATEWAY_TOKEN=
# Expo uses publishable credentials only; copy to apps/mobile/.env.local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
